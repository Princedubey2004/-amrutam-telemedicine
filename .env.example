# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://amrutam_user:amrutam_password@localhost:5432/amrutam_telemedicine?schema=public

# Database Credentials for Docker Compose (Local Development)
POSTGRES_USER=amrutam_user
POSTGRES_PASSWORD=amrutam_password
POSTGRES_DB=amrutam_telemedicine
POSTGRES_PORT=5432

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# CORS Allowed Origin
CORS_ORIGIN=*

# Payment Gateway Configuration
# In production, PAYMENT_PROVIDER must be configured to 'razorpay' or 'stripe'
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev_payment_webhook_secret_key_12345
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
